# ---------------------------------------------------------------------------
# Copiá este archivo como .env.local y completá los valores.
# Nunca subas .env.local al repositorio.
# ---------------------------------------------------------------------------

# Base de datos (Neon: cadena con ?sslmode=require)
DATABASE_URL="postgresql://usuario:password@host/basedatos?sslmode=require"
# Neon entrega una URL sin pooling para migraciones de Prisma
DIRECT_URL="postgresql://usuario:password@host/basedatos?sslmode=require"

# Autenticación (Auth.js v5)
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Cloudinary — almacenamiento y transformación de imágenes
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Datos públicos del negocio
# Número en formato internacional sin + ni espacios
NEXT_PUBLIC_WHATSAPP_NUMBER="50600000000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Nombre del emprendimiento"

# Semilla del usuario administrador (solo desarrollo)
SEED_ADMIN_EMAIL="admin@ejemplo.com"
SEED_ADMIN_PASSWORD="Cambiar123!"
